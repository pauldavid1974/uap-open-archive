{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pauldavid1974/uap-open-archive/schema/case.schema.json",
  "title": "Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "in_pursue_catalog", "records", "entities", "labels"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,80}$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["explained", "disputed", "unexplained"] },
    "in_pursue_catalog": { "type": "boolean" },
    "incident_date": { "type": ["string", "null"] },
    "location": { "type": ["string", "null"] },
    "records": { "type": "array", "items": { "type": "string" } },
    "entities": { "type": "array", "items": { "type": "string" } },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["official", "press", "advocate", "skeptic", "analysis"] }
    }
  }
}
