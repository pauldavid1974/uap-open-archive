{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pauldavid1974/uap-open-archive/schema/record.schema.json",
  "title": "PURSUE catalog record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "official_id",
    "title",
    "collection",
    "agency",
    "type",
    "type_raw",
    "release_date",
    "incident_date",
    "incident_date_raw",
    "incident_date_precision",
    "location",
    "location_raw",
    "catalog_redaction_flag",
    "redaction_level",
    "witnesses",
    "sensors",
    "labels",
    "featured",
    "sources",
    "related_cases",
    "underlying_file_opened",
    "catalog_order",
    "file_size_bytes",
    "sha256"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,118}$" },
    "official_id": { "type": ["string", "null"] },
    "id_note": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "collection": {
      "type": "string",
      "enum": ["pursue-01", "pursue-02", "pursue-03", "pursue-04", "pursue-05", "pursue-06"]
    },
    "agency": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "enum": ["document", "video", "image", "audio"] },
    "type_raw": { "type": "string" },
    "release_date": { "type": "string", "format": "date" },
    "incident_date": { "type": ["string", "null"] },
    "incident_date_raw": { "type": "string" },
    "incident_date_precision": {
      "type": "string",
      "enum": ["day", "month", "year", "range", "approximate", "unknown"]
    },
    "location": { "type": ["string", "null"] },
    "location_raw": { "type": "string" },
    "catalog_redaction_flag": { "type": "boolean" },
    "redaction_level": { "type": "string", "enum": ["flagged", "not_flagged"] },
    "witnesses": { "type": "array", "items": { "type": "string" } },
    "sensors": { "type": "array", "items": { "type": "string" } },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["official", "press", "advocate", "skeptic", "analysis"] }
    },
    "featured": { "type": "boolean" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "label", "url"],
        "properties": {
          "role": { "type": "string" },
          "label": { "type": "string", "enum": ["official", "press", "advocate", "skeptic", "analysis"] },
          "url": { "type": ["string", "null"] },
          "archive_url": { "type": ["string", "null"] },
          "note": { "type": "string" }
        }
      }
    },
    "related_cases": { "type": "array", "items": { "type": "string" } },
    "related_records": { "type": "array", "items": { "type": "string" } },
    "underlying_file_opened": { "type": "boolean" },
    "catalog_order": { "type": "integer", "minimum": 1 },
    "dvids_id": { "type": ["string", "null"] },
    "file_size_bytes": { "type": ["integer", "null"] },
    "http_etag": { "type": ["string", "null"] },
    "media_url": { "type": ["string", "null"] },
    "sha256": { "type": ["string", "null"] },
    "image_virin": { "type": ["string", "null"] },
    "video_pairing": { "type": "array", "items": { "type": "string" } },
    "pdf_pairing": { "type": "array", "items": { "type": "string" } }
  }
}
