{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pauldavid1974/uap-open-archive/schema/entity.schema.json",
  "title": "Entity",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "kind", "labels"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,80}$" },
    "title": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["person", "place", "program", "agency", "platform"]
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["official", "press", "advocate", "skeptic", "analysis"] }
    },
    "cases": { "type": "array", "items": { "type": "string" } }
  }
}
